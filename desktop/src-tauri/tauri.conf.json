{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "microtranslate",
  "version": "0.1.0",
  "identifier": "io.github.adityakasal.microtranslate",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "microtranslate",
        "width": 1040,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "English to neutral Latin American Spanish, on your device.",
    "longDescription": "Speech in, neutral Latin American Spanish out. Runs entirely on this machine with no server, no API and no internet after first setup.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
